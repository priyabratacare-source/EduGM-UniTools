    ];

    // State Variables
    let currentFilter = 'all';
    let filteredQuestions = [...rawQuestionsData];
    let currentIndex = 0;
    let userAnswers = {}; // map question.id -> selectedOptionIndex
    let flaggedQuestions = new Set();
    let quizMode = 'practice'; // 'practice' or 'exam'
    let examTimerInterval = null;
    let examTimeRemaining = 25 * 60; // 25 minutes
    let examTimeElapsed = 0;

    // Initialization
    window.addEventListener('DOMContentLoaded', () => {
      renderCurrentQuestion();
      renderPalette();
      updateStats();
    });

    // Filtering
    function setFilter(cat) {
      currentFilter = cat;
      document.querySelectorAll('.filter-chip').forEach(el => {
        el.className = "filter-chip px-3 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-600 border border-slate-200 hover:bg-slate-200 transition";
      });
      const activeBtn = document.getElementById(`filter-${cat}`);
      if (activeBtn) {
        activeBtn.className = "filter-chip px-3 py-1 rounded-full text-xs font-semibold bg-indigo-100 text-indigo-700 border border-indigo-200 transition";
      }

      if (cat === 'all') {
        filteredQuestions = [...rawQuestionsData];
      } else {
        filteredQuestions = rawQuestionsData.filter(q => q.category === cat);
      }

      currentIndex = 0;
      renderCurrentQuestion();
      renderPalette();
      updateStats();
    }

    // Switch between Practice & Exam modes
    function switchMode(mode) {
      quizMode = mode;
      const practiceBtn = document.getElementById('btn-practice-mode');
      const examBtn = document.getElementById('btn-exam-mode');
      const timerWrapper = document.getElementById('exam-timer-wrapper');
      const practiceStats = document.getElementById('practice-stats');
      const examSubmitWrapper = document.getElementById('exam-mode-submit-btn-wrapper');

      if (mode === 'exam') {
        practiceBtn.className = "px-3 py-1.5 rounded-md transition-all flex items-center gap-1.5 text-indigo-200 hover:text-white";
        examBtn.className = "px-3 py-1.5 rounded-md transition-all flex items-center gap-1.5 bg-indigo-600 text-white shadow-sm";
        timerWrapper.classList.remove('hidden');
        practiceStats.classList.add('hidden');
        examSubmitWrapper.classList.remove('hidden');
        startExamTimer();
      } else {
        examBtn.className = "px-3 py-1.5 rounded-md transition-all flex items-center gap-1.5 text-indigo-200 hover:text-white";
        practiceBtn.className = "px-3 py-1.5 rounded-md transition-all flex items-center gap-1.5 bg-indigo-600 text-white shadow-sm";
        timerWrapper.classList.add('hidden');
        practiceStats.classList.remove('hidden');
        examSubmitWrapper.classList.add('hidden');
        clearInterval(examTimerInterval);
      }
      renderCurrentQuestion();
      renderPalette();
    }

    // Timer logic
    function startExamTimer() {
      clearInterval(examTimerInterval);
      examTimeRemaining = 25 * 60;
      examTimeElapsed = 0;
      updateTimerDisplay();

      examTimerInterval = setInterval(() => {
        examTimeRemaining--;
        examTimeElapsed++;
        updateTimerDisplay();
        if (examTimeRemaining <= 0) {
          clearInterval(examTimerInterval);
          alert('Time is up! Submitting exam automatically.');
          submitExam();
        }
      }, 1000);
    }

    function updateTimerDisplay() {
      const minutes = Math.floor(examTimeRemaining / 60);
      const seconds = examTimeRemaining % 60;
      const el = document.getElementById('exam-timer');
      if (el) {
        el.innerText = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
      }
    }

    // Render Question & Options
    function renderCurrentQuestion() {
      if (filteredQuestions.length === 0) return;

      const q = filteredQuestions[currentIndex];
      const selected = userAnswers[q.id];

      // Badges & Headers
      document.getElementById('badge-question-num').innerText = `Question ${currentIndex + 1} of ${filteredQuestions.length}`;
      document.getElementById('badge-source').innerText = `${q.source} (${q.categoryName})`;

      // Flag button state
      const flagBtn = document.getElementById('btn-flag');
      if (flaggedQuestions.has(q.id)) {
        flagBtn.className = "text-amber-500 font-medium transition text-sm flex items-center gap-1";
        flagBtn.innerHTML = '<i class="fa-solid fa-bookmark"></i> <span class="text-xs">Flagged</span>';
      } else {
        flagBtn.className = "text-slate-400 hover:text-amber-500 transition text-sm flex items-center gap-1";
        flagBtn.innerHTML = '<i class="fa-regular fa-bookmark"></i> <span class="text-xs">Flag</span>';
      }

      // Question Title
      document.getElementById('question-text').innerHTML = q.question;

      // Options Rendering
      const container = document.getElementById('options-container');
      container.innerHTML = '';

      const letters = ['A', 'B', 'C', 'D'];

      q.options.forEach((optText, optIdx) => {
        const btn = document.createElement('button');
        btn.onclick = () => selectOption(q.id, optIdx);

        let baseClasses = "w-full text-left p-4 rounded-xl border transition flex items-center gap-3.5 ";
        let badgeClasses = "w-8 h-8 rounded-lg flex items-center justify-center font-bold text-xs shrink-0 ";

        if (quizMode === 'practice') {
          // If in practice mode and an answer has been chosen:
          if (selected !== undefined) {
            if (optIdx === q.correctIndex) {
              baseClasses += "bg-emerald-50 border-emerald-300 text-emerald-950 font-medium ";
              badgeClasses += "bg-emerald-500 text-white ";
            } else if (optIdx === selected) {
              baseClasses += "bg-rose-50 border-rose-300 text-rose-950 ";
              badgeClasses += "bg-rose-500 text-white ";
            } else {
              baseClasses += "bg-slate-50/50 border-slate-200 text-slate-400 opacity-60 ";
              badgeClasses += "bg-slate-200 text-slate-500 ";
            }
          } else {
            baseClasses += "bg-white border-slate-200 hover:border-indigo-300 hover:bg-indigo-50/30 text-slate-700 ";
            badgeClasses += "bg-slate-100 text-slate-600 ";
          }
        } else {
          // Exam Mode
          if (selected === optIdx) {
            baseClasses += "bg-indigo-50 border-indigo-400 text-indigo-950 font-medium shadow-sm ";
            badgeClasses += "bg-indigo-600 text-white ";
          } else {
            baseClasses += "bg-white border-slate-200 hover:border-slate-300 hover:bg-slate-50 text-slate-700 ";
            badgeClasses += "bg-slate-100 text-slate-600 ";
          }
        }

        btn.className = baseClasses;
        btn.innerHTML = `
          <span class="${badgeClasses}">${letters[optIdx]}</span>
          <span class="flex-1 text-sm md:text-base">${optText}</span>
          ${quizMode === 'practice' && selected !== undefined ? (
            optIdx === q.correctIndex ? '<i class="fa-solid fa-circle-check text-emerald-600 text-lg"></i>' :
            (optIdx === selected ? '<i class="fa-solid fa-circle-xmark text-rose-500 text-lg"></i>' : '')
          ) : ''}
        `;
        container.appendChild(btn);
      });

      // Explanation box in practice mode
      const expBox = document.getElementById('explanation-box');
      if (quizMode === 'practice' && selected !== undefined) {
        expBox.classList.remove('hidden');
        if (selected === q.correctIndex) {
          expBox.className = "mt-6 p-4 rounded-xl border bg-emerald-50/80 border-emerald-200 text-emerald-900";
          document.getElementById('explanation-title').innerHTML = '<i class="fa-solid fa-circle-check text-emerald-600"></i> Correct! Conceptual Rationale:';
        } else {
          expBox.className = "mt-6 p-4 rounded-xl border bg-amber-50/80 border-amber-200 text-amber-900";
          document.getElementById('explanation-title').innerHTML = '<i class="fa-solid fa-triangle-exclamation text-amber-600"></i> Incorrect. Conceptual Rationale:';
        }
        document.getElementById('explanation-text').innerHTML = q.explanation;
      } else {
        expBox.classList.add('hidden');
      }

      // Prev/Next buttons
      document.getElementById('btn-prev').disabled = (currentIndex === 0);
      document.getElementById('btn-next').disabled = (currentIndex === filteredQuestions.length - 1);

      // Re-trigger MathJax to format newly inserted formulas
      if (window.MathJax) {
        MathJax.typesetPromise();
      }
    }

    // Select Option
    function selectOption(qId, optIdx) {
      if (quizMode === 'practice' && userAnswers[qId] !== undefined) {
        // In practice mode, allow changing choice freely to see comparison
      }
      userAnswers[qId] = optIdx;
      renderCurrentQuestion();
      renderPalette();
      updateStats();
    }

    // Clear Answer
    function clearCurrentAnswer() {
      const q = filteredQuestions[currentIndex];
      if (q && userAnswers[q.id] !== undefined) {
        delete userAnswers[q.id];
        renderCurrentQuestion();
        renderPalette();
        updateStats();
      }
    }

    // Navigation
    function prevQuestion() {
      if (currentIndex > 0) {
        currentIndex--;
        renderCurrentQuestion();
      }
    }

    function nextQuestion() {
      if (currentIndex < filteredQuestions.length - 1) {
        currentIndex++;
        renderCurrentQuestion();
      }
    }

    function jumpToQuestion(idx) {
      currentIndex = idx;
      renderCurrentQuestion();
    }

    // Toggle Flag
    function toggleFlagCurrentQuestion() {
      const q = filteredQuestions[currentIndex];
      if (flaggedQuestions.has(q.id)) {
        flaggedQuestions.delete(q.id);
      } else {
        flaggedQuestions.add(q.id);
      }
      renderCurrentQuestion();
      renderPalette();
    }

    // Palette Generation
    function renderPalette() {
      const grid = document.getElementById('palette-grid');
      grid.innerHTML = '';
      document.getElementById('palette-count').innerText = `${filteredQuestions.length} Items`;

      filteredQuestions.forEach((q, idx) => {
        const btn = document.createElement('button');
        btn.onclick = () => jumpToQuestion(idx);

        const isAnswered = userAnswers[q.id] !== undefined;
        const isFlagged = flaggedQuestions.has(q.id);
        const isCurrent = idx === currentIndex;

        let btnClasses = "h-9 w-full rounded-lg text-xs font-bold transition flex items-center justify-center relative ";

        if (isCurrent) {
          btnClasses += "ring-2 ring-indigo-600 ring-offset-2 ";
        }

        if (isAnswered) {
          btnClasses += "bg-emerald-500 hover:bg-emerald-600 text-white shadow-sm ";
        } else if (isFlagged) {
          btnClasses += "bg-amber-400 hover:bg-amber-500 text-amber-950 shadow-sm ";
        } else {
          btnClasses += "bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 ";
        }

        btn.className = btnClasses;
        btn.innerHTML = `${idx + 1}${isFlagged ? '<span class="absolute top-1 right-1 w-1.5 h-1.5 bg-amber-400 rounded-full"></span>' : ''}`;
        grid.appendChild(btn);
      });
    }

    // Update Progress Stats
    function updateStats() {
      const answeredCount = Object.keys(userAnswers).length;
      const total = rawQuestionsData.length;
      document.getElementById('stat-answered').innerText = answeredCount;
      document.getElementById('stat-total').innerText = total;

      const pct = Math.round((answeredCount / total) * 100);
      document.getElementById('practice-progress-bar').style.width = `${pct}%`;
    }

    // Shuffle questions
    function shuffleCurrentQuestions() {
      for (let i = filteredQuestions.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [filteredQuestions[i], filteredQuestions[j]] = [filteredQuestions[j], filteredQuestions[i]];
      }
      currentIndex = 0;
      renderCurrentQuestion();
      renderPalette();
    }

    // Reset Quiz
    function resetCurrentQuiz() {
      if (confirm("Reset all chosen answers and start fresh?")) {
        userAnswers = {};
        flaggedQuestions.clear();
        currentIndex = 0;
        if (quizMode === 'exam') {
          startExamTimer();
        }
        renderCurrentQuestion();
        renderPalette();
        updateStats();
      }
    }

    // Exam Submission & Results
    function submitExam() {
      clearInterval(examTimerInterval);

      let correctCount = 0;
      let totalQuestions = rawQuestionsData.length;

      let agCorrect = 0, agTotal = 4;
      let kineticsCorrect = 0, kineticsTotal = 15;
      let catalysisCorrect = 0, catalysisTotal = 6;

      rawQuestionsData.forEach(q => {
        const userChoice = userAnswers[q.id];
        const isRight = (userChoice === q.correctIndex);
        if (isRight) {
          correctCount++;
          if (q.category === 'ag') agCorrect++;
          if (q.category === 'kinetics') kineticsCorrect++;
          if (q.category === 'catalysis') catalysisCorrect++;
        }
      });

      const accuracy = Math.round((correctCount / totalQuestions) * 100);

      // Populate Modal
      document.getElementById('modal-score').innerText = `${correctCount} / ${totalQuestions}`;
      document.getElementById('modal-accuracy').innerText = `${accuracy}%`;

      const minutesSpent = Math.floor(examTimeElapsed / 60);
      const secondsSpent = examTimeElapsed % 60;
      document.getElementById('modal-time').innerText = `${minutesSpent.toString().padStart(2, '0')}:${secondsSpent.toString().padStart(2, '0')}`;

      document.getElementById('breakdown-ag').innerText = `${agCorrect} / ${agTotal} (${Math.round((agCorrect / agTotal) * 100)}%)`;
      document.getElementById('breakdown-kinetics').innerText = `${kineticsCorrect} / ${kineticsTotal} (${Math.round((kineticsCorrect / kineticsTotal) * 100)}%)`;
      document.getElementById('breakdown-catalysis').innerText = `${catalysisCorrect} / ${catalysisTotal} (${Math.round((catalysisCorrect / catalysisTotal) * 100)}%)`;

      const iconBadge = document.getElementById('result-icon-badge');
      const title = document.getElementById('result-title');

      if (accuracy >= 80) {
        iconBadge.className = "w-16 h-16 rounded-2xl mx-auto flex items-center justify-center text-3xl mb-3 bg-emerald-100 text-emerald-600";
        iconBadge.innerHTML = '<i class="fa-solid fa-trophy"></i>';
        title.innerText = "Excellent Preparation!";
      } else if (accuracy >= 50) {
        iconBadge.className = "w-16 h-16 rounded-2xl mx-auto flex items-center justify-center text-3xl mb-3 bg-indigo-100 text-indigo-600";
        iconBadge.innerHTML = '<i class="fa-solid fa-thumbs-up"></i>';
        title.innerText = "Good Effort! Keep Reviewing.";
      } else {
        iconBadge.className = "w-16 h-16 rounded-2xl mx-auto flex items-center justify-center text-3xl mb-3 bg-amber-100 text-amber-600";
        iconBadge.innerHTML = '<i class="fa-solid fa-book-open"></i>';
        title.innerText = "Needs More Practice.";
      }

      document.getElementById('result-modal').classList.remove('hidden');
    }

    function reviewExamAnswers() {
      document.getElementById('result-modal').classList.add('hidden');
      switchMode('practice');
    }

    function restartExam() {
      document.getElementById('result-modal').classList.add('hidden');
      userAnswers = {};
      flaggedQuestions.clear();
      currentIndex = 0;
      setFilter('all');
      switchMode('exam');
    }
  </script>
</body>
</html>
