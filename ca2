        source: "Dr. AD Part",
        category: "catalysis",
        categoryName: "Catalysis",
        question: "Which of the following is an example of an enzyme catalyst?",
        options: [
          "$\\text{Fe}$",
          "$\\text{Ni}$",
          "Platinum",
