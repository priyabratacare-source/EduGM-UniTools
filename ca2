  <script>
    // Complete Dataset strictly extracted from the two PDFs
    const rawQuestionsData = [
      // --- PDF 1: Dr. Aishwarya Mukherjee (AG Ma'am) ---
      {
        id: 1,
        source: "Dr. AG Ma'am",
        category: "ag",
        categoryName: "Water & Thermo",
        question: "The hardness of water is due to the presence of:",
        options: [
          "Monovalent cation",
          "Bivalent cation",
          "Trivalent cation",
          "Both b & c"
        ],
        correctIndex: 3,
        explanation: "Hardness of water is caused by multivalent/polyvalent metal cations, primarily bivalent cations ($Ca^{2+}, Mg^{2+}$) as well as trivalent cations ($Fe^{3+}, Al^{3+}$). Monovalent cations like $Na^+$ and $K^+$ do not cause hardness."
      },
      {
        id: 2,
        source: "Dr. AG Ma'am",
        category: "ag",
        categoryName: "Water & Thermo",
        question: "Which of the following thermodynamic laws gives the concept of enthalpy?",
        options: [
          "First law of thermodynamics",
          "Second law of thermodynamics",
          "Third law of thermodynamics",
          "None of the above"
        ],
        correctIndex: 0,
        explanation: "The First Law of Thermodynamics ($dU = dq + dw$) leads directly to the definition of enthalpy ($H = U + PV$). Heat exchanged at constant pressure equals the change in enthalpy ($q_p = \\Delta H$)."
      },
      {
        id: 3,
        source: "Dr. AG Ma'am",
        category: "ag",
        categoryName: "Water & Thermo",
        question: "In which of the following systems does mass transfer occur across the system boundary?",
        options: [
          "Isolated system",
          "Closed system",
          "Open system",
          "None of the mentioned"
        ],
        correctIndex: 2,
        explanation: "An open system allows both energy and matter (mass) transfer across its boundary. A closed system permits only energy transfer, while an isolated system permits neither."
      },
      {
        id: 4,
        source: "Dr. AG Ma'am",
        category: "ag",
        categoryName: "Water & Thermo",
        question: "With the increase in temperature, Dissolved Oxygen (DO) in water:",
        options: [
          "Increases",
          "Decreases",
          "Remains same",
          "None of the above"
        ],
        correctIndex: 1,
        explanation: "The dissolution of a gas in water is an exothermic process. According to Henry's Law and Le Chatelier's principle, increasing temperature decreases gas solubility, leading to a decrease in Dissolved Oxygen (DO)."
      },

      // --- PDF 2: Dr. AD's Part (Chemical Kinetics) ---
      {
        id: 5,
        source: "Dr. AD Part",
        category: "kinetics",
        categoryName: "Chemical Kinetics",
        question: "The rate of a chemical reaction is generally expressed as:",
        options: [
          "Change in concentration per unit time",
          "Change in temperature per unit time",
          "Change in pressure per unit volume",
          "Change in volume per unit concentration"
        ],
        correctIndex: 0,
        explanation: "The rate of a chemical reaction is defined as the change in the concentration of reactants or products per unit time ($\\text{Rate} = -\\frac{d[R]}{dt} = +\\frac{d[P]}{dt}$)."
      },
      {
        id: 6,
        source: "Dr. AD Part",
        category: "kinetics",
        categoryName: "Chemical Kinetics",
        question: "The half-life ($t_{1/2}$) of a second-order reaction (with initial concentration $a$ and rate constant $k$) is:",
